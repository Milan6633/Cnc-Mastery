---
import BaseLayout from './BaseLayout.astro';
import { getAllModules, getLessonsByModule, getAdjacentLessons, getLessonUrl, getModuleUrl, levelInfo } from '@utils/lessons';

interface Props {
  title: string;
  description: string;
  module: string;
  lessonNumber: number;
  objectives: string[];
  duration: string;
  difficulty: string;
}

const { title, description, module: moduleSlug, lessonNumber, objectives, duration, difficulty } = Astro.props;

const allModules = await getAllModules();
const currentModule = allModules.find(m => m.data.slug === moduleSlug);
const moduleLessons = await getLessonsByModule(moduleSlug);
const { prev, next } = await getAdjacentLessons(moduleSlug, lessonNumber);
const level = currentModule ? levelInfo[currentModule.data.level] : null;
---

<BaseLayout title={title} description={description}>
  <div class="lesson-page">
    <!-- Sidebar -->
    <aside class="lesson-sidebar" id="lesson-sidebar">
      <div class="sidebar-header">
        {currentModule && (
          <>
            <a href={getModuleUrl(currentModule.data.slug)} class="sidebar-module-link">
              <span class="sidebar-module-icon">{currentModule.data.icon}</span>
              <span class="sidebar-module-title">{currentModule.data.title}</span>
            </a>
            {level && <span class={`badge ${level.badgeClass}`}>{level.name}</span>}
          </>
        )}
      </div>
      <nav class="sidebar-nav" aria-label="Module lessons">
        <ul class="sidebar-lessons">
          {moduleLessons.map(lesson => (
            <li>
              <a
                href={getLessonUrl(lesson)}
                class:list={['sidebar-lesson-link', { active: lesson.data.lessonNumber === lessonNumber }]}
              >
                <span class="sidebar-lesson-number">{String(lesson.data.lessonNumber).padStart(2, '0')}</span>
                <span class="sidebar-lesson-title">{lesson.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <article class="lesson-content">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/syllabus">Syllabus</a></li>
          {currentModule && <li><a href={getModuleUrl(currentModule.data.slug)}>{currentModule.data.title}</a></li>}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <!-- Lesson Header -->
      <header class="lesson-header">
        <div class="lesson-meta">
          {level && <span class={`badge ${level.badgeClass}`}>Level {currentModule?.data.levelNumber}</span>}
          <span class="meta-item">⏱️ {duration}</span>
          <span class="meta-item capitalize">📊 {difficulty}</span>
        </div>
        <h1 class="lesson-title">{title}</h1>
        <p class="lesson-description">{description}</p>
      </header>

      <!-- Learning Objectives -->
      {objectives.length > 0 && (
        <div class="objectives-box">
          <h2 class="objectives-heading">🎯 Learning Objectives</h2>
          <ul class="objectives-list">
            {objectives.map(obj => (
              <li>{obj}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Lesson Body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Prev/Next Navigation -->
      <nav class="lesson-nav" aria-label="Lesson navigation">
        {prev ? (
          <a href={getLessonUrl(prev)} class="lesson-nav-card prev">
            <span class="lesson-nav-label">← Previous Lesson</span>
            <span class="lesson-nav-title">{prev.data.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={getLessonUrl(next)} class="lesson-nav-card next">
            <span class="lesson-nav-label">Next Lesson →</span>
            <span class="lesson-nav-title">{next.data.title}</span>
          </a>
        ) : (
          <a href="/syllabus" class="lesson-nav-card next">
            <span class="lesson-nav-label">Completed! →</span>
            <span class="lesson-nav-title">Back to Syllabus</span>
          </a>
        )}
      </nav>
    </article>
  </div>

  <!-- Mobile sidebar toggle -->
  <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle lesson sidebar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
    Lessons
  </button>

  <script>
    const toggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('lesson-sidebar');

    toggle?.addEventListener('click', () => {
      sidebar?.classList.toggle('open');
    });

    // Close sidebar when clicking a link (mobile)
    sidebar?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        sidebar?.classList.remove('open');
      });
    });
  </script>
</BaseLayout>

<style>
  .lesson-page {
    display: flex;
    min-height: calc(100vh - var(--header-height));
  }

  /* ===== Sidebar ===== */
  .lesson-sidebar {
    position: fixed;
    top: var(--header-height);
    left: 0;
    bottom: 0;
    width: 280px;
    background: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    padding: var(--space-4) 0;
    transform: translateX(-100%);
    transition: transform var(--transition-normal);
    z-index: 50;
  }

  @media (min-width: 1024px) {
    .lesson-sidebar {
      position: sticky;
      transform: none;
      flex-shrink: 0;
    }
  }

  .lesson-sidebar.open {
    transform: translateX(0);
    box-shadow: var(--shadow-lg);
  }

  .sidebar-header {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .sidebar-module-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
    margin-bottom: var(--space-2);
  }

  .sidebar-module-link:hover {
    color: var(--color-accent-primary);
  }

  .sidebar-module-icon {
    font-size: 1.25rem;
  }

  .sidebar-lessons {
    padding: 0 var(--space-2);
  }

  .sidebar-lesson-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    line-height: var(--leading-snug);
  }

  .sidebar-lesson-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-tertiary);
  }

  .sidebar-lesson-link.active {
    color: var(--color-accent-primary);
    background: var(--color-callout-info-bg);
    font-weight: var(--weight-medium);
  }

  .sidebar-lesson-number {
    color: var(--color-text-tertiary);
    font-family: var(--font-code);
    font-size: var(--text-xs);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* ===== Main Content ===== */
  .lesson-content {
    flex: 1;
    min-width: 0;
    max-width: 50rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-6) var(--space-16);
  }

  @media (min-width: 1024px) {
    .lesson-content {
      padding: var(--space-8) var(--space-10) var(--space-16);
    }
  }

  /* Breadcrumb */
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    list-style: none;
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-1);
    color: var(--color-text-tertiary);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-primary);
  }

  .breadcrumb [aria-current] {
    color: var(--color-text-primary);
  }

  /* Lesson Header */
  .lesson-header {
    margin-top: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .meta-item {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .capitalize {
    text-transform: capitalize;
  }

  .lesson-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-top: var(--space-2);
  }

  .lesson-description {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* Objectives Box */
  .objectives-box {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-callout-info-bg);
    border: 1px solid var(--color-callout-info-border);
    border-radius: var(--radius-lg);
  }

  .objectives-heading {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
    border-bottom: none;
    padding-bottom: 0;
  }

  .objectives-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .objectives-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .objectives-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent-secondary);
    font-weight: var(--weight-bold);
  }

  /* Lesson Nav (prev/next) */
  .lesson-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .lesson-nav-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .lesson-nav-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .lesson-nav-card.next {
    text-align: right;
  }

  .lesson-nav-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .lesson-nav-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-primary);
    margin-top: var(--space-1);
  }

  @media (max-width: 639px) {
    .lesson-nav {
      grid-template-columns: 1fr;
    }

    .lesson-nav-card.next {
      text-align: left;
    }
  }

  /* Sidebar toggle (mobile) */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: fixed;
    bottom: var(--space-4);
    left: var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 40;
  }

  @media (min-width: 1024px) {
    .sidebar-toggle {
      display: none;
    }
  }
</style>
