---
// Language toggle button — cycles between English, Finnish, and Hindi.
// Uses localStorage to persist preference; client-side JS swaps all [data-i18n] text.
---

<button class="lang-toggle" id="lang-toggle" aria-label="Switch language" title="Switch language">
  <span class="lang-label" id="lang-label">FI</span>
</button>

<script>
  // Language toggle: swaps all [data-i18n] elements with their translation
  const STORAGE_KEY = 'cnc-mastery-lang';
  const LANGS = ['en', 'fi', 'hi'] as const;
  type Lang = (typeof LANGS)[number];

  const LABELS: Record<Lang, string> = { en: 'FI', fi: 'HI', hi: 'EN' };
  const TITLES: Record<Lang, string> = {
    en: 'Vaihda suomeksi', // shown while current lang is 'en' -> next is 'fi'
    fi: 'हिन्दी में बदलें', // shown while current lang is 'fi' -> next is 'hi'
    hi: 'Switch to English', // shown while current lang is 'hi' -> next is 'en'
  };

  function getLang(): Lang {
    const stored = localStorage.getItem(STORAGE_KEY);
    return (LANGS as readonly string[]).includes(stored || '') ? (stored as Lang) : 'en';
  }

  function nextLang(current: Lang): Lang {
    const idx = LANGS.indexOf(current);
    return LANGS[(idx + 1) % LANGS.length];
  }

  function setLang(lang: Lang) {
    localStorage.setItem(STORAGE_KEY, lang);
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);
    applyTranslations(lang);
    updateToggleButton(lang);
  }

  function updateToggleButton(lang: Lang) {
    const label = document.getElementById('lang-label');
    if (label) {
      label.textContent = LABELS[lang];
    }
    const btn = document.getElementById('lang-toggle');
    if (btn) {
      btn.setAttribute('title', TITLES[lang]);
    }
  }

  function applyTranslations(lang: Lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const enText = el.getAttribute('data-i18n-en');
      const fiText = el.getAttribute('data-i18n-fi');
      const hiText = el.getAttribute('data-i18n-hi');
      if (lang === 'hi' && hiText) {
        el.textContent = hiText;
      } else if (lang === 'fi' && fiText) {
        el.textContent = fiText;
      } else if (enText) {
        el.textContent = enText;
      }
    });

    // Also swap aria-labels
    document.querySelectorAll('[data-i18n-aria]').forEach(el => {
      const enText = el.getAttribute('data-i18n-aria-en');
      const fiText = el.getAttribute('data-i18n-aria-fi');
      const hiText = el.getAttribute('data-i18n-aria-hi');
      if (lang === 'hi' && hiText) {
        el.setAttribute('aria-label', hiText);
      } else if (lang === 'fi' && fiText) {
        el.setAttribute('aria-label', fiText);
      } else if (enText) {
        el.setAttribute('aria-label', enText);
      }
    });
  }

  // Initialize
  const currentLang = getLang();
  document.documentElement.setAttribute('data-lang', currentLang);
  document.documentElement.setAttribute('lang', currentLang);
  updateToggleButton(currentLang);
  applyTranslations(currentLang);

  // Toggle handler — cycles EN -> FI -> HI -> EN
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    setLang(nextLang(getLang()));
  });
</script>

<style>
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1.5px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
  }

  .lang-toggle:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    background: var(--color-callout-info-bg);
  }
</style>
