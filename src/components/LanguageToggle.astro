---
// Language toggle button — switches between English and Finnish.
// Uses localStorage to persist preference; client-side JS swaps all [data-i18n] text.
---

<button class="lang-toggle" id="lang-toggle" aria-label="Switch language" title="Switch language">
  <span class="lang-label" id="lang-label">FI</span>
</button>

<script>
  // Language toggle: swaps all [data-i18n] elements with their translation
  const STORAGE_KEY = 'cnc-mastery-lang';

  function getLang(): string {
    return localStorage.getItem(STORAGE_KEY) || 'en';
  }

  function setLang(lang: string) {
    localStorage.setItem(STORAGE_KEY, lang);
    document.documentElement.setAttribute('data-lang', lang);
    applyTranslations(lang);
    updateToggleButton(lang);
  }

  function updateToggleButton(lang: string) {
    const label = document.getElementById('lang-label');
    if (label) {
      label.textContent = lang === 'en' ? 'FI' : 'EN';
    }
    const btn = document.getElementById('lang-toggle');
    if (btn) {
      btn.setAttribute('title', lang === 'en' ? 'Vaihda suomeksi' : 'Switch to English');
    }
  }

  function applyTranslations(lang: string) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const enText = el.getAttribute('data-i18n-en');
      const fiText = el.getAttribute('data-i18n-fi');
      if (lang === 'fi' && fiText) {
        el.textContent = fiText;
      } else if (enText) {
        el.textContent = enText;
      }
    });

    // Also swap aria-labels
    document.querySelectorAll('[data-i18n-aria]').forEach(el => {
      const enText = el.getAttribute('data-i18n-aria-en');
      const fiText = el.getAttribute('data-i18n-aria-fi');
      if (lang === 'fi' && fiText) {
        el.setAttribute('aria-label', fiText);
      } else if (enText) {
        el.setAttribute('aria-label', enText);
      }
    });
  }

  // Initialize
  const currentLang = getLang();
  document.documentElement.setAttribute('data-lang', currentLang);
  updateToggleButton(currentLang);
  applyTranslations(currentLang);

  // Toggle handler
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const current = getLang();
    setLang(current === 'en' ? 'fi' : 'en');
  });
</script>

<style>
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1.5px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
  }

  .lang-toggle:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    background: var(--color-callout-info-bg);
  }
</style>
