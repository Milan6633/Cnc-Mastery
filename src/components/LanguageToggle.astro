---
// Language switcher — three always-visible buttons (EN / FI / HI).
// Uses localStorage to persist preference; client-side JS swaps all
// [data-i18n] text and marks the active button with aria-pressed.
const langs = [
  { code: 'en', label: 'EN', title: 'Switch to English' },
  { code: 'fi', label: 'FI', title: 'Vaihda suomeksi' },
  { code: 'hi', label: 'HI', title: 'हिन्दी में बदलें' },
] as const;
---

<div class="lang-group" role="group" aria-label="Switch language">
  {langs.map((l) => (
    <button
      class="lang-btn"
      data-lang-btn={l.code}
      aria-pressed="false"
      title={l.title}
    >
      {l.label}
    </button>
  ))}
</div>

<script>
  // Language switcher: swaps all [data-i18n] elements with their translation
  const STORAGE_KEY = 'cnc-mastery-lang';
  const LANGS = ['en', 'fi', 'hi'] as const;
  type Lang = (typeof LANGS)[number];

  function getLang(): Lang {
    const stored = localStorage.getItem(STORAGE_KEY);
    return (LANGS as readonly string[]).includes(stored || '') ? (stored as Lang) : 'en';
  }

  function setLang(lang: Lang) {
    localStorage.setItem(STORAGE_KEY, lang);
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);
    applyTranslations(lang);
    updateButtons(lang);
  }

  function updateButtons(lang: Lang) {
    document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
      const isActive = btn.dataset.langBtn === lang;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });
  }

  function applyTranslations(lang: Lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const enText = el.getAttribute('data-i18n-en');
      const fiText = el.getAttribute('data-i18n-fi');
      const hiText = el.getAttribute('data-i18n-hi');
      if (lang === 'hi' && hiText) {
        el.textContent = hiText;
      } else if (lang === 'fi' && fiText) {
        el.textContent = fiText;
      } else if (enText) {
        el.textContent = enText;
      }
    });

    // Also swap aria-labels
    document.querySelectorAll('[data-i18n-aria]').forEach(el => {
      const enText = el.getAttribute('data-i18n-aria-en');
      const fiText = el.getAttribute('data-i18n-aria-fi');
      const hiText = el.getAttribute('data-i18n-aria-hi');
      if (lang === 'hi' && hiText) {
        el.setAttribute('aria-label', hiText);
      } else if (lang === 'fi' && fiText) {
        el.setAttribute('aria-label', fiText);
      } else if (enText) {
        el.setAttribute('aria-label', enText);
      }
    });
  }

  // Initialize
  const currentLang = getLang();
  document.documentElement.setAttribute('data-lang', currentLang);
  document.documentElement.setAttribute('lang', currentLang);
  updateButtons(currentLang);
  applyTranslations(currentLang);

  // Click handlers — each button selects its language directly
  document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.langBtn as Lang;
      if (lang && lang !== getLang()) {
        setLang(lang);
      }
    });
  });
</script>

<style>
  .lang-group {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    background: var(--color-bg-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 1.875rem;
    padding: 0 0.4rem;
    background: none;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: calc(var(--radius-md) - 3px);
    transition: all var(--transition-fast);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    font-family: var(--font-code);
  }

  .lang-btn:hover {
    color: var(--color-accent-primary);
  }

  .lang-btn.active {
    background: var(--color-accent-primary);
    color: var(--color-on-accent);
  }

  .lang-btn.active:hover {
    color: var(--color-on-accent);
  }
</style>
