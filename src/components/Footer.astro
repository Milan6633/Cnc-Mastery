---
import { baseUrl } from '@utils/lessons';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={baseUrl('/')} class="footer-logo">CNC <span>Mastery</span></a>
        <p class="footer-tagline">Learn CNC machining online — from blueprint to finished part. No school required.</p>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">Course</h3>
        <ul>
          <li><a href={baseUrl('/syllabus')}>Full Syllabus</a></li>
          <li><a href={baseUrl('/module/01-shop-safety')}>Start Learning</a></li>
          <li><a href={baseUrl('/reference/gcode')}>G-Code Reference</a></li>
          <li><a href={baseUrl('/reference/formulas')}>Shop Math Formulas</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">More</h3>
        <ul>
          <li><a href={baseUrl('/resources')}>Resources & Books</a></li>
          <li><a href={baseUrl('/about')}>About</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} CNC Mastery. Built by Milan Khadka.</p>
      <p class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        All systems nominal
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: calc(1.5 * 1.75rem) 0;
    margin-top: var(--space-20);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .footer-logo span {
    color: var(--color-accent-primary);
  }

  .footer-tagline {
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 30ch;
  }

  .footer-heading {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-4);
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-accent-primary);
  }

  .footer-bottom {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }

  .footer-status {
    display: none;
  }

  .status-dot {
    display: none;
  }
</style>
