---
import { baseUrl } from '@utils/lessons';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container container">
    <div class="footer-coord" aria-hidden="true">
      <span>X <span class="coord-val readout">0.000</span></span>
      <span>Y <span class="coord-val readout">0.000</span></span>
      <span>Z <span class="coord-val readout">0.000</span></span>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <a href={baseUrl('/')} class="footer-logo">CNC <span>Mastery</span></a>
        <p class="footer-tagline">Learn CNC machining online — from blueprint to finished part. No school required.</p>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">Course</h3>
        <ul>
          <li><a href={baseUrl('/syllabus')}>Full Syllabus</a></li>
          <li><a href={baseUrl('/module/01-shop-safety')}>Start Learning</a></li>
          <li><a href={baseUrl('/reference/gcode')}>G-Code Reference</a></li>
          <li><a href={baseUrl('/reference/formulas')}>Shop Math Formulas</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">More</h3>
        <ul>
          <li><a href={baseUrl('/resources')}>Resources & Books</a></li>
          <li><a href={baseUrl('/about')}>About</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} CNC Mastery. Built by Milan Khadka.</p>
      <p class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        All systems nominal
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    padding: var(--space-12) 0 var(--space-8);
    margin-top: var(--space-20);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-logo {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .footer-logo span {
    color: var(--color-accent-primary);
  }

  .footer-tagline {
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 30ch;
  }

  .footer-heading {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-4);
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-accent-primary);
  }

  /* Coordinate readout strip — echoes the DRO */
  .footer-coord {
    font-family: var(--font-code);
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .footer-coord span {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .coord-val {
    color: var(--color-accent-primary);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .footer-bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-status {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-accent-secondary);
    box-shadow: 0 0 0 2px rgba(53, 208, 127, 0.12);
  }
</style>
