---
import BaseLayout from '@layouts/BaseLayout.astro';
import { baseUrl } from '@utils/lessons';

const levels = [
  {
    number: 1,
    name: 'Foundation',
    color: 'var(--color-level-1)',
    badgeClass: 'badge-foundation',
    modules: '01–05',
    moduleCount: 5,
    description: 'Safety, shop math, blueprints, measurement, materials science',
    icon: '🔧',
  },
  {
    number: 2,
    name: 'Core CNC',
    color: 'var(--color-level-2)',
    badgeClass: 'badge-core',
    modules: '06–11',
    moduleCount: 6,
    description: 'Manual machining, cutting tools, workholding, G-code programming',
    icon: '⚙️',
  },
  {
    number: 3,
    name: 'Advanced',
    color: 'var(--color-level-3)',
    badgeClass: 'badge-advanced',
    modules: '12–17',
    moduleCount: 6,
    description: 'CAD/CAM, GD&T, setup optimization, quality systems',
    icon: '📐',
  },
  {
    number: 4,
    name: 'Specialist',
    color: 'var(--color-level-4)',
    badgeClass: 'badge-specialist',
    modules: '18–20',
    moduleCount: 3,
    description: '5-axis machining, macro programming, Industry 4.0',
    icon: '🚀',
  },
];

const features = [
  {
    icon: '📘',
    title: 'Complete Syllabus',
    description: '20 modules covering everything from shop safety to 5-axis machining — structured like a professional training program.',
  },
  {
    icon: '💻',
    title: 'G-Code & CAM',
    description: 'Learn to write G-code from scratch, then master CAD/CAM with Fusion 360 and Mastercam toolpath strategies.',
  },
  {
    icon: '📏',
    title: 'Blueprint & GD&T',
    description: 'Read engineering drawings, understand GD&T callouts, and apply tolerances like a professional machinist.',
  },
  {
    icon: '🏭',
    title: 'Industry Standards',
    description: 'Curriculum aligned with NIMS certifications, Haas training, MIT OCW, and real community college programs.',
  },
];

const stats = [
  { value: '20', label: 'Modules' },
  { value: '4', label: 'Skill Levels' },
  { value: '127+', label: 'Lessons' },
  { value: 'Free', label: 'Forever' },
];
---

<BaseLayout title="Learn CNC Machining Online">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content container">
      <span class="hero-badge badge badge-core" data-i18n="hero.badge" data-i18n-en="Free Online Course" data-i18n-fi="Ilmainen verkkokurssi">Free Online Course</span>
      <h1 class="hero-title">
        <span data-i18n="hero.title1" data-i18n-en="Master CNC Machining" data-i18n-fi="Hallitse CNC-koneistus">Master CNC Machining</span><br />
        <span class="hero-highlight" data-i18n="hero.title2" data-i18n-en="Without 3 Years of School" data-i18n-fi="Ilman 3 vuoden koulua">Without 3 Years of School</span>
      </h1>
      <p class="hero-description" data-i18n="hero.desc" data-i18n-en="A complete, structured curriculum — from shop safety to 5-axis programming. Built from NIMS, Haas, MIT OCW, and industry-standard training programs." data-i18n-fi="Täydellinen, jäsennelty opetussuunnitelma — työturvallisuudesta 5-akseliseen ohjelmointiin. Rakennettu NIMS-, Haas-, MIT OCW- ja alan standardiohjelmien pohjalta.">
        A complete, structured curriculum — from shop safety to 5-axis programming.
        Built from NIMS, Haas, MIT&nbsp;OCW, and industry-standard training programs.
      </p>
      <div class="hero-actions">
        <a href={baseUrl('/syllabus')} class="btn btn-primary" data-i18n="hero.cta1" data-i18n-en="View Full Syllabus" data-i18n-fi="Katso opetussuunnitelma">View Full Syllabus</a>
        <a href={baseUrl('/module/01-shop-safety')} class="btn btn-secondary" data-i18n="hero.cta2" data-i18n-en="Start Learning →" data-i18n-fi="Aloita oppiminen →">Start Learning →</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-section">
    <div class="stats-grid container">
      {stats.map((stat, i) => (
        <div class="stat-item">
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label" data-i18n={`stat.${i}`} data-i18n-en={stat.label} data-i18n-fi={stat.labelFi}>{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <h2 class="section-title" data-i18n="features.title" data-i18n-en="Everything You Need to Learn CNC" data-i18n-fi="Kaikki mitä tarvitset CNC:n oppimiseen">Everything You Need to Learn CNC</h2>
      <p class="section-subtitle" data-i18n="features.sub" data-i18n-en="No prior experience required. Start from the basics and work your way up to specialist-level skills." data-i18n-fi="Aiempaa kokemusta ei tarvita. Aloita perusteista ja etene asiantuntijatasolle.">
        No prior experience required. Start from the basics and work your way up to specialist-level skills.
      </p>
      <div class="features-grid">
        {features.map((feature, i) => (
          <div class="feature-card">
            <span class="feature-icon">{feature.icon}</span>
            <h3 class="feature-title" data-i18n={`feat.t.${i}`} data-i18n-en={feature.title} data-i18n-fi={feature.titleFi}>{feature.title}</h3>
            <p class="feature-description" data-i18n={`feat.d.${i}`} data-i18n-en={feature.description} data-i18n-fi={feature.descFi}>{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Curriculum Preview -->
  <section class="curriculum-section">
    <div class="container">
      <h2 class="section-title" data-i18n="curr.title" data-i18n-en="Your Learning Path" data-i18n-fi="Oppimispolkusi">Your Learning Path</h2>
      <p class="section-subtitle" data-i18n="curr.sub" data-i18n-en="4 levels, 20 modules — structured to take you from zero to professional-level competency." data-i18n-fi="4 tasoa, 20 moduulia — rakennettu viemään sinut nollasta ammattitasolle.">
        4 levels, 20 modules — structured to take you from zero to professional-level competency.
      </p>
      <div class="levels-grid">
        {levels.map((level, i) => (
          <div class="level-card" style={`--level-color: ${level.color}`}>
            <div class="level-header">
              <span class="level-icon">{level.icon}</span>
              <div>
                <span class={`badge ${level.badgeClass}`}>Level {level.number}</span>
                <h3 class="level-name" data-i18n={`lvl.${i}`} data-i18n-en={level.name} data-i18n-fi={level.nameFi}>{level.name}</h3>
              </div>
            </div>
            <p class="level-description" data-i18n={`lvl.d.${i}`} data-i18n-en={level.description} data-i18n-fi={level.descFi}>{level.description}</p>
            <div class="level-meta">
              <span>Modules {level.modules}</span>
              <span>{level.moduleCount} modules</span>
            </div>
          </div>
        ))}
      </div>
      <div class="curriculum-cta">
        <a href={baseUrl('/syllabus')} class="btn btn-primary" data-i18n="curr.cta" data-i18n-en="Explore Full Curriculum →" data-i18n-fi="Tutustu opetussuunnitelmaan →">Explore Full Curriculum →</a>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="about-section">
    <div class="container container-md">
      <div class="about-card">
        <h2 class="about-title" data-i18n="about.title" data-i18n-en="Built by a Machinist, for Machinists" data-i18n-fi="Koneistajan rakentama, koneistajille">Built by a Machinist, for Machinists</h2>
        <p class="about-text" data-i18n="about.text" data-i18n-en="I'm Milan — a mechanical engineer and CNC machinist trained at Varia (Finland). I created CNC Mastery because I believe everyone deserves access to quality CNC education, not locked behind expensive schools or outdated textbooks." data-i18n-fi="Olen Milan — koneinsinööri ja CNC-koneistaja, valmistunut Variasta (Suomi). Loin CNC Masteryn, koska uskon, että kaikilla on oikeus laadukkaaseen CNC-koulutukseen — ilman kalliita kouluja tai vanhentuneita oppikirjoja.">
          I'm Milan — a mechanical engineer and CNC machinist trained at Varia (Finland).
          I created CNC Mastery because I believe everyone deserves access to quality
          CNC education, not locked behind expensive schools or outdated textbooks.
        </p>
        <a href={baseUrl('/about')} class="btn btn-secondary" data-i18n="about.cta" data-i18n-en="Learn More About the Project →" data-i18n-fi="Lue lisää projektista →">Learn More About the Project →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% -10%, rgba(59, 130, 246, 0.12), transparent),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(168, 85, 247, 0.06), transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
  }

  .hero-badge {
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, var(--text-5xl));
    font-weight: var(--weight-extrabold);
    line-height: 1.1;
    margin-top: var(--space-4);
    letter-spacing: -0.02em;
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--color-accent-primary), var(--color-level-3));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    max-width: 600px;
    margin: var(--space-6) auto 0;
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-accent-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .btn-secondary {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-elevated);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  /* ===== Stats ===== */
  .stats-section {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    text-align: center;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-value {
    display: block;
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-accent-primary);
  }

  .stat-label {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ===== Sections Common ===== */
  .section-title {
    text-align: center;
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 50ch;
    margin: var(--space-3) auto 0;
    font-size: var(--text-lg);
  }

  .features-section,
  .curriculum-section {
    padding: var(--space-20) 0;
  }

  /* ===== Features ===== */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
  }

  .feature-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-3);
  }

  .feature-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }

  .feature-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* ===== Curriculum / Levels ===== */
  .levels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  @media (min-width: 640px) {
    .levels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .level-card {
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--level-color);
    transition: all var(--transition-normal);
  }

  .level-card:hover {
    border-color: var(--level-color);
    box-shadow: var(--shadow-md);
  }

  .level-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .level-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .level-name {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    margin-top: var(--space-1);
  }

  .level-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .level-meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .curriculum-cta {
    text-align: center;
    margin-top: var(--space-10);
  }

  /* ===== About Teaser ===== */
  .about-section {
    padding: var(--space-16) 0;
  }

  .about-card {
    text-align: center;
    padding: var(--space-10);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .about-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .about-text {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 55ch;
    margin-left: auto;
    margin-right: auto;
  }

  .about-card .btn {
    margin-top: var(--space-6);
  }
</style>
