---
import BaseLayout from '@layouts/BaseLayout.astro';
import { baseUrl } from '@utils/lessons';

const levels = [
  {
    code: 'L1',
    name: 'Foundation',
    nameFi: 'Perusta',
    color: 'var(--color-level-1)',
    badgeClass: 'badge-foundation',
    modules: '01–05',
    moduleCount: 5,
    description: 'Safety, shop math, blueprints, measurement, materials science',
    descFi: 'Turvallisuus, konepajamatematiikka, piirustukset, mittaus, materiaalioppi',
  },
  {
    code: 'L2',
    name: 'Core CNC',
    nameFi: 'CNC:n ydin',
    color: 'var(--color-level-2)',
    badgeClass: 'badge-core',
    modules: '06–11',
    moduleCount: 6,
    description: 'Manual machining, cutting tools, workholding, G-code programming',
    descFi: 'Manuaalikoneistus, terät, kiinnittimet, G-koodin ohjelmointi',
  },
  {
    code: 'L3',
    name: 'Advanced',
    nameFi: 'Edistynyt',
    color: 'var(--color-level-3)',
    badgeClass: 'badge-advanced',
    modules: '12–17',
    moduleCount: 6,
    description: 'CAD/CAM, GD&T, setup optimization, quality systems',
    descFi: 'CAD/CAM, GD&T, asetusten optimointi, laatujärjestelmät',
  },
  {
    code: 'L4',
    name: 'Specialist',
    nameFi: 'Asiantuntija',
    color: 'var(--color-level-4)',
    badgeClass: 'badge-specialist',
    modules: '18–20',
    moduleCount: 3,
    description: '5-axis machining, macro programming, Industry 4.0',
    descFi: '5-akselinen koneistus, makro-ohjelmointi, Teollisuus 4.0',
  },
];

const features = [
  {
    icon: 'sheet',
    panel: 'A',
    zone: 'Curriculum',
    zoneFi: 'Opetussuunnitelma',
    title: 'Complete Syllabus',
    titleFi: 'Täysi opetussuunnitelma',
    description:
      '20 modules covering everything from shop safety to 5-axis machining — structured like a professional training program.',
    descFi:
      '20 moduulia työturvallisuudesta 5-akseliseen koneistukseen — rakennettu kuten ammatillinen koulutusohjelma.',
  },
  {
    icon: 'toolpath',
    panel: 'B',
    zone: 'Programming',
    zoneFi: 'Ohjelmointi',
    title: 'G-Code & CAM',
    titleFi: 'G-koodi ja CAM',
    description:
      'Write G-code from scratch, then move to CAD/CAM with Fusion 360 and Mastercam toolpath strategies.',
    descFi:
      'Kirjoita G-koodia alusta alkaen ja siirry sitten CAD/CAM-työhön Fusion 360:n ja Mastercamin ratastrategioilla.',
  },
  {
    icon: 'dimension',
    panel: 'C',
    zone: 'Metrology',
    zoneFi: 'Metrologia',
    title: 'Blueprint & GD&T',
    titleFi: 'Piirustukset ja GD&T',
    description:
      'Read engineering drawings, interpret GD&T callouts, and apply tolerances the way the shop floor expects.',
    descFi:
      'Lue teknisiä piirustuksia, tulkitse GD&T-merkinnät ja sovella toleransseja kuten konepajassa odotetaan.',
  },
  {
    icon: 'stamp',
    panel: 'D',
    zone: 'Standards',
    zoneFi: 'Standardit',
    title: 'Industry Standards',
    titleFi: 'Alan standardit',
    description:
      'Curriculum aligned with NIMS certifications, Haas training, MIT OCW, and real community college programs.',
    descFi:
      'Opetussuunnitelma noudattaa NIMS-sertifiointeja, Haas-koulutusta, MIT OCW:tä ja oikeita oppilaitosohjelmia.',
  },
];

// DRO fields — the hero readout. Values are counted up on load.
const readout = [
  { field: 'MODULES', value: 20, display: '20', labelFi: 'MODUULIA' },
  { field: 'LEVELS', value: 4, display: '04', labelFi: 'TASOA' },
  { field: 'LESSONS', value: 127, display: '127', labelFi: 'OPPITUNTIA' },
  { field: 'COST', value: 0, display: '0.00', labelFi: 'HINTA' },
];
---

<BaseLayout title="Learn CNC Machining Online">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true">
      <div class="hero-origin"></div>
      <span class="hero-axis hero-axis-x">X+</span>
      <span class="hero-axis hero-axis-y">Y+</span>
    </div>
    <div class="hero-inner container">
      <p class="hero-eyebrow label">
        <span class="lamp" aria-hidden="true"></span>
        <span
          data-i18n="hero.badge"
          data-i18n-en="Free · Open · No enrolment"
          data-i18n-fi="Ilmainen · Avoin · Ei ilmoittautumista">Free · Open · No enrolment</span>
      </p>

      <h1 class="hero-title">
        <span
          data-i18n="hero.title1"
          data-i18n-en="Master CNC machining"
          data-i18n-fi="Hallitse CNC-koneistus">Master CNC machining</span><br />
        <span
          class="hero-title-accent"
          data-i18n="hero.title2"
          data-i18n-en="without three years of school"
          data-i18n-fi="ilman kolmen vuoden koulua">without three years of school</span>
      </h1>

      <p
        class="hero-description"
        data-i18n="hero.desc"
        data-i18n-en="A full curriculum, in order, from shop safety to 5-axis programming. Built from NIMS, Haas, MIT OCW, and the training programmes shops actually hire from."
        data-i18n-fi="Täysi opetussuunnitelma järjestyksessä työturvallisuudesta 5-akseliseen ohjelmointiin. Rakennettu NIMS:n, Haasin, MIT OCW:n ja niiden ohjelmien pohjalta, joista konepajat oikeasti palkkaavat.">
        A full curriculum, in order, from shop safety to 5-axis programming.
        Built from NIMS, Haas, MIT&nbsp;OCW, and the training programmes shops
        actually hire from.
      </p>

      <div class="hero-actions">
        <a
          href={baseUrl('/module/01-shop-safety')}
          class="btn btn-primary"
          data-i18n="hero.cta2"
          data-i18n-en="Start module 01"
          data-i18n-fi="Aloita moduuli 01">Start module 01</a>
        <a
          href={baseUrl('/syllabus')}
          class="btn btn-secondary"
          data-i18n="hero.cta1"
          data-i18n-en="View full syllabus"
          data-i18n-fi="Katso opetussuunnitelma">View full syllabus</a>
      </div>
    </div>
  </section>

  <!-- DRO strip: the machine readout -->
  <section class="dro" aria-label="Course at a glance">
    <div class="dro-inner container">
      {readout.map((r, i) => (
        <div class="dro-field">
          <span
            class="dro-label label"
            data-i18n={`dro.${i}`}
            data-i18n-en={r.field}
            data-i18n-fi={r.labelFi}>
            <span class="dro-dot" aria-hidden="true"></span>
            {r.field}
          </span>
          <span class="dro-value readout" data-count={r.value} data-display={r.display}>
            {r.display}
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="container">
      <p class="section-eyebrow label" data-i18n="features.eyebrow" data-i18n-en="What you get" data-i18n-fi="Mitä saat">What you get</p>
      <h2
        class="section-title"
        data-i18n="features.title"
        data-i18n-en="Everything you need to learn CNC"
        data-i18n-fi="Kaikki mitä tarvitset CNC:n oppimiseen">Everything you need to learn CNC</h2>
      <p
        class="section-subtitle"
        data-i18n="features.sub"
        data-i18n-en="No prior experience required. Start at the basics and work up to specialist work."
        data-i18n-fi="Aiempaa kokemusta ei tarvita. Aloita perusteista ja etene asiantuntijatasolle.">
        No prior experience required. Start at the basics and work up to specialist work.
      </p>

      <div class="features-grid">
        {features.map((feature, i) => (
          <article class="feature-card">
            <div class="feature-panel-header">
              <span class="feature-lamp" aria-hidden="true"></span>
              <span
                class="feature-panel-label"
                data-i18n={`feat.p.${i}`}
                data-i18n-en={`Panel ${feature.panel} · ${feature.zone}`}
                data-i18n-fi={`Paneeli ${feature.panel} · ${feature.zoneFi}`}>Panel {feature.panel} · {feature.zone}</span>
            </div>
            <span class="feature-icon" aria-hidden="true">
              {feature.icon === 'sheet' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
                  <rect x="4" y="3" width="24" height="26" />
                  <path d="M19 22h9M19 25.5h9M4 22h11M4 25.5h11" />
                  <path d="M8 8h11M8 12h16M8 16h8" />
                </svg>
              )}
              {feature.icon === 'toolpath' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
                  <rect x="3" y="6" width="26" height="20" />
                  <path d="M8 21V11h8a4 4 0 0 1 0 8h-8" stroke-dasharray="2.5 2" />
                  <circle cx="8" cy="21" r="2.25" fill="currentColor" stroke="none" />
                </svg>
              )}
              {feature.icon === 'dimension' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
                  <path d="M6 6v14M26 6v14" />
                  <path d="M6 16h20" />
                  <path d="M9.5 13 6 16l3.5 3M22.5 13 26 16l-3.5 3" />
                  <path d="M6 26h20" stroke-dasharray="2 2.5" />
                </svg>
              )}
              {feature.icon === 'stamp' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
                  <circle cx="16" cy="16" r="12" />
                  <circle cx="16" cy="16" r="8.5" stroke-dasharray="2 2.5" />
                  <path d="m11.5 16 3 3 6-6" />
                </svg>
              )}
            </span>
            <h3
              class="feature-title"
              data-i18n={`feat.t.${i}`}
              data-i18n-en={feature.title}
              data-i18n-fi={feature.titleFi}>{feature.title}</h3>
            <p
              class="feature-description"
              data-i18n={`feat.d.${i}`}
              data-i18n-en={feature.description}
              data-i18n-fi={feature.descFi}>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Curriculum: the tempering ramp -->
  <section class="curriculum">
    <div class="container">
      <p class="section-eyebrow label" data-i18n="curr.eyebrow" data-i18n-en="The path" data-i18n-fi="Polku">The path</p>
      <h2
        class="section-title"
        data-i18n="curr.title"
        data-i18n-en="Four levels, twenty modules"
        data-i18n-fi="Neljä tasoa, kaksikymmentä moduulia">Four levels, twenty modules</h2>
      <p
        class="section-subtitle"
        data-i18n="curr.sub"
        data-i18n-en="Levels run cold to hot, the way steel colours as it tempers. Start at L1 and work up."
        data-i18n-fi="Tasot etenevät kylmästä kuumaan, kuten teräs värjäytyy päästökarkaisussa. Aloita L1:stä ja etene ylöspäin.">
        Levels run cold to hot, the way steel colours as it tempers. Start at L1 and work up.
      </p>

      <ol class="levels">
        {levels.map((level, i) => (
          <li class="level-card" style={`--level-color: ${level.color}`} data-level={i + 1}>
            <div class="level-top">
              <span class="level-code readout">{level.code}</span>
              <h3
                class="level-name"
                data-i18n={`lvl.${i}`}
                data-i18n-en={level.name}
                data-i18n-fi={level.nameFi}>{level.name}</h3>
            </div>
            <p
              class="level-description"
              data-i18n={`lvl.d.${i}`}
              data-i18n-en={level.description}
              data-i18n-fi={level.descFi}>{level.description}</p>
            <p class="level-meta label">
              <span class="readout">{level.modules}</span>
              <span class="readout">{level.moduleCount} mod</span>
            </p>
            <span class="level-temp-bar" aria-hidden="true"></span>
          </li>
        ))}
      </ol>

      <div class="curriculum-cta">
        <a
          href={baseUrl('/syllabus')}
          class="btn btn-primary"
          data-i18n="curr.cta"
          data-i18n-en="Explore full curriculum"
          data-i18n-fi="Tutustu opetussuunnitelmaan">Explore full curriculum</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about">
    <div class="container container-md">
      <div class="about-card">
        <p class="section-eyebrow label" data-i18n="about.eyebrow" data-i18n-en="Who made this" data-i18n-fi="Kuka tämän teki">Who made this</p>
        <h2
          class="about-title"
          data-i18n="about.title"
          data-i18n-en="Built by a machinist, for machinists"
          data-i18n-fi="Koneistajan rakentama, koneistajille">Built by a machinist, for machinists</h2>
        <p
          class="about-text"
          data-i18n="about.text"
          data-i18n-en="I'm Milan — a mechanical engineer and CNC machinist trained at Varia in Finland. I built CNC Mastery because good CNC training shouldn't sit behind tuition fees or twenty-year-old textbooks."
          data-i18n-fi="Olen Milan — koneinsinööri ja CNC-koneistaja, koulutettu Variassa Suomessa. Rakensin CNC Masteryn, koska hyvän CNC-koulutuksen ei pitäisi olla lukukausimaksujen tai kaksikymmentä vuotta vanhojen oppikirjojen takana.">
          I'm Milan — a mechanical engineer and CNC machinist trained at Varia in
          Finland. I built CNC Mastery because good CNC training shouldn't sit
          behind tuition fees or twenty-year-old textbooks.
        </p>
        <a
          href={baseUrl('/about')}
          class="btn btn-secondary"
          data-i18n="about.cta"
          data-i18n-en="More about the project"
          data-i18n-fi="Lisää projektista">More about the project</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // DRO homing sequence: digits count up once, on load.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fields = document.querySelectorAll<HTMLElement>('.dro-value');

  if (!reduced) {
    fields.forEach((el) => {
      const target = Number(el.dataset.count ?? 0);
      const final = el.dataset.display ?? '';
      const decimals = final.includes('.') ? final.split('.')[1].length : 0;
      const pad = final.split('.')[0].length;
      const duration = 900;
      const start = performance.now();

      const frame = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        // ease-out: fast approach, settles like an axis reaching position
        const eased = 1 - Math.pow(1 - t, 3);
        const value = (target * eased).toFixed(decimals);
        el.textContent = value.padStart(pad + (decimals ? decimals + 1 : 0), '0');
        if (t < 1) requestAnimationFrame(frame);
        else el.textContent = final;
      };
      requestAnimationFrame(frame);
    });

    // Scroll reveal: axis-homing entrance animation
    const reveals = document.querySelectorAll<HTMLElement>(
      '.feature-card, .level-card, .about-card'
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.classList.add('revealed');
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );

    reveals.forEach((el, i) => {
      // Stagger siblings within the same parent
      const siblings = Array.from(el.parentElement?.children ?? []);
      const idx = siblings.indexOf(el);
      el.style.transitionDelay = `${idx * 60}ms`;
      el.classList.add('reveal-ready');
      observer.observe(el);
    });
  }
</script>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding: var(--space-24) 0 var(--space-20);
    overflow: hidden;
  }

  /* Drawing-sheet grid — CNC coordinate system */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 90% 70% at 20% 0%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 20% 0%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  /* Origin crosshair at first grid intersection */
  .hero-origin {
    position: absolute;
    top: 44px;
    left: 44px;
    width: 44px;
    height: 44px;
  }

  .hero-origin::before,
  .hero-origin::after {
    content: '';
    position: absolute;
    background: var(--color-accent-primary);
    opacity: 0.3;
  }

  .hero-origin::before {
    top: 50%;
    left: -22px;
    width: 88px;
    height: 1px;
    transform: translateY(-0.5px);
  }

  .hero-origin::after {
    left: 50%;
    top: -22px;
    width: 1px;
    height: 88px;
    transform: translateX(-0.5px);
  }

  .hero-axis {
    position: absolute;
    font-family: var(--font-code);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent-primary);
    opacity: 0.35;
  }

  .hero-axis-x {
    top: calc(44px + 26px);
    left: calc(44px + 50px);
  }

  .hero-axis-y {
    top: calc(44px - 28px);
    left: calc(44px + 5px);
  }

  .hero-inner {
    position: relative;
    max-width: 62rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
  }

  .lamp {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--color-accent-secondary);
    box-shadow: 0 0 0 3px rgba(53, 208, 127, 0.15);
  }

  .hero-title {
    margin-top: var(--space-5);
    font-size: clamp(2.75rem, 7.5vw, 5.25rem);
    font-weight: var(--weight-bold);
    line-height: 0.95;
    letter-spacing: 0.002em;
    text-transform: uppercase;
    max-width: 18ch;
  }

  .hero-title-accent {
    color: var(--color-accent-primary);
  }

  .hero-description {
    max-width: 54ch;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-code);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), color var(--transition-fast),
      border-color var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--color-accent-primary);
    color: var(--color-on-accent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .btn-secondary:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  /* ===== DRO strip (signature) ===== */
  .dro {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-inset);
    position: relative;
  }

  /* Scan-line texture — subtle CRT/LCD overlay */
  .dro::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
    pointer-events: none;
  }

  .dro-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    position: relative;
  }

  @media (min-width: 720px) {
    .dro-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dro-field {
    padding: var(--space-6) var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .dro-field:first-child {
    border-left: none;
  }

  /* On two-column mobile the third field starts a new row */
  @media (max-width: 719px) {
    .dro-field:nth-child(odd) {
      border-left: none;
    }
    .dro-field:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  .dro-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dro-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-accent-primary);
    opacity: 0.5;
    flex-shrink: 0;
  }

  .dro-value {
    display: block;
    margin-top: var(--space-2);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--color-accent-primary);
    letter-spacing: 0.04em;
    text-shadow: 0 0 20px var(--color-accent-glow);
  }

  /* ===== Section furniture ===== */
  .section-eyebrow {
    display: block;
  }

  .section-title {
    margin-top: var(--space-3);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    line-height: 1;
  }

  .section-subtitle {
    max-width: 58ch;
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .features,
  .curriculum {
    padding: var(--space-24) 0;
  }

  .curriculum {
    border-top: 1px solid var(--color-border);
  }

  /* ===== Features ===== */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin-top: var(--space-12);
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    padding: var(--space-8);
